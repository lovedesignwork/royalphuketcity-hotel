{
  "functions": {
    "app/api/admin/downloads/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/cron/seo-sync",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/seo-report",
      "schedule": "0 6 1 * *"
    }
  ],
  "redirects": [
    {
      "source": "/sales-kit",
      "destination": "/download-fact-sheets",
      "permanent": true
    }
  ]
}
