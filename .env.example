# Supabase (required for visitor tracking, contact form, and blog)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend (optional - for sending contact form emails)
RESEND_API_KEY=your-resend-api-key

# Google Analytics (optional - for GA4 tracking)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# AI API Keys (required for AI Blog Writer - configure at least one)
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# Site URL (for API calls in server components)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
