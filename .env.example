# Supabase (required for visitor tracking, contact form, and blog)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend (optional - for sending contact form emails)
RESEND_API_KEY=your-resend-api-key

# Google Analytics (optional - for GA4 tracking)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# AI API Keys (required for AI Blog Writer - configure at least one)
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# Site URL (for API calls in server components)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SEO Rank Dashboard (/admin/seo)
# --- Google Search Console API (service account) ---
# Create a service account in Google Cloud, enable the Search Console API,
# then add the service account email as a user on your verified GSC property.
GOOGLE_SERVICE_ACCOUNT_EMAIL=seo-bot@your-project.iam.gserviceaccount.com
# Paste the whole private key. Keep the literal \n sequences on one line.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The property exactly as registered in Search Console. Either a URL-prefix
# property ("https://royalphuketcity.com/") or a domain property
# ("sc-domain:royalphuketcity.com").
GSC_SITE_URL=https://royalphuketcity.com/
# --- SerpApi (live Google rank checks) ---
SERPAPI_KEY=your-serpapi-key
# --- Cron protection (Vercel sends this automatically once set) ---
CRON_SECRET=generate-a-long-random-string
# --- Monthly report recipients (comma-separated) ---
SEO_REPORT_EMAIL=marketing@royalphuketcity.com
